diff --git a/src/core/rosetta.h b/src/core/rosetta.h
index 735c054..32efe34 100644
--- a/src/core/rosetta.h
+++ b/src/core/rosetta.h
@@ -55,6 +55,7 @@
  * VZ Linux VM.
  */
 #define ROSETTA_VZ_CHECK 0x80456125 /* Returns 69-byte signature */
+#define ROSETTA_VZ_CHECK_LEGACY 0x80456122 /* macOS 14 Rosetta probe */
 #define ROSETTA_VZ_CAPS 0x80806123  /* Returns 128-byte capability blob */
 #define ROSETTA_VZ_ACTIVATE 0x6124  /* Activate VZ mode (just returns 1) */
 
diff --git a/src/syscall/io.c b/src/syscall/io.c
index 76fcbbb..acb6728 100644
--- a/src/syscall/io.c
+++ b/src/syscall/io.c
@@ -957,7 +957,9 @@ static bool rosetta_ioctl_target_fd(guest_t *g, int host_fd)
 /* Returns true if request matches one of the Rosetta VZ probe ioctls. */
 static bool rosetta_vz_request(uint64_t request)
 {
-    return request == ROSETTA_VZ_CHECK || request == ROSETTA_VZ_CAPS ||
+    return request == ROSETTA_VZ_CHECK ||
+           request == ROSETTA_VZ_CHECK_LEGACY ||
+           request == ROSETTA_VZ_CAPS ||
            request == ROSETTA_VZ_ACTIVATE;
 }
 
@@ -969,7 +971,8 @@ static bool rosetta_vz_request(uint64_t request)
 static int64_t rosetta_vz_ioctl(guest_t *g, uint64_t request, uint64_t arg)
 {
     switch (request) {
-    case ROSETTA_VZ_CHECK: {
+    case ROSETTA_VZ_CHECK:
+    case ROSETTA_VZ_CHECK_LEGACY: {
         static const char rosetta_sig[ROSETTA_VZ_SIG_LEN] =
             "Our hard work\nby these words guarded\n"
             "please don't steal\n\xc2\xa9 Apple Inc";
